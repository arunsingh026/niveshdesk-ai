DATABASE_URL=postgresql+psycopg://stockplanner:stockplanner@db:5432/stockplanner
APP_TIMEZONE=Asia/Kolkata
MONTHLY_BUDGET=35000
MF_BUDGET=30000
INVESTMENT_DAY=5
REMINDER_HOUR=9
REMINDER_MINUTE=0
DRY_RUN_NOTIFICATIONS=true
MARKET_DATA_PROVIDER=yfinance
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_API_VERSION=v23.0

# Mobile/web notification center. Keep private values out of Git.
PUBLIC_APP_URL=http://localhost:5173
NOTIFICATION_CRON_TOKEN=
RESEND_API_KEY=
RESEND_FROM=NiveshDesk <onboarding@resend.dev>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
NOTIFICATION_TEST_COOLDOWN_SECONDS=10

# Multi-user authentication. Generate peppers/tokens outside source control.
AUTH_SESSION_DAYS=30
AUTH_CODE_MINUTES=10
AUTH_COOKIE_NAME=niveshdesk_session
AUTH_CODE_PEPPER=
ALLOW_REGISTRATION=true

# Private PDF form workspace. Local storage is used unless Azure is configured.
PDF_STORAGE_PATH=./data/pdf_forms
PDF_MAX_UPLOAD_MB=20
PDF_MAX_PAGES=30
# Optional dedicated secret. When blank, AUTH_CODE_PEPPER or DATABASE_URL derives the encryption key.
PDF_VALUE_ENCRYPTION_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_PDF_CONTAINER=niveshdesk-pdf-forms
